{
  "id": "pos-testbed",
  "repo_url": "https://github.com/panca1093/legos-pos-testbed.git",
  "repo": "panca1093/legos-pos-testbed",
  "default_branch": "main",
  "scm_kind": "github",
  "scm_token_env": "LF_GITHUB_TOKEN",
  "env": {
    "setup": "npm ci",
    "verify": ["npm run typecheck", "npm test"],
    "test_pkg": "npx vitest run {pkg}"
  },
  "builder": {
    "profile": {"agent": "claude-agent-acp", "provider": "anthropic", "model": "claude-sonnet-5-5", "billing_kind": "subscription"},
    "env": {"CLAUDE_CODE_OAUTH_TOKEN": "${CLAUDE_CODE_OAUTH_TOKEN}"}
  },
  "protected_paths": ["src/payment/**"],
  "max_level": 2,
  "required_checks": ["test"]
}
