<script setup lang="ts">
import { computed, nextTick, onMounted, ref, watch } from "vue";
import AppDialog from "../../components/ui/AppDialog.vue";
import { useEditor } from "./editorStore";

const store = useEditor();
const query = ref("");
const paths = ref<string[]>([]);
const sel = ref(0);
const input = ref<HTMLInputElement>();

export interface Scored {
  path: string;
  score: number;
}
</script>

<script lang="ts">
// Subsequence match: consecutive and basename hits score higher; null when the query is not a subsequence.
export function fuzzyScore(query: string, path: string): number | null {
  const q = query.toLowerCase(),
    p = path.toLowerCase();
  if (!q) return 0;
  const base = p.lastIndexOf("/") + 1;
  let qi = 0,
    score = 0,
    last = -2;
  for (let i = 0; i < p.length && qi < q.length; i++) {
    if (p[i] !== q[qi]) continue;
    score += 1;
    if (i === last + 1) score += 3;
    if (i >= base) score += 2;
    if (i === 0 || "/._-".includes(p[i - 1])) score += 3;
    last = i;
    qi++;
  }
  return qi === q.length ? score - path.length / 100 : null;
}
export function rankPaths(query: string, all: string[], limit = 50): string[] {
  const out: { path: string; score: number }[] = [];
  for (const path of all) {
    const score = fuzzyScore(query, path);
    if (score !== null) out.push({ path, score });
  }
  return out
    .sort((a, b) => b.score - a.score)
    .slice(0, limit)
    .map((x) => x.path);
}
</script>

<script setup lang="ts">
const results = computed(() => rankPaths(query.value, paths.value));
watch(query, () => (sel.value = 0));
onMounted(async () => {
  paths.value = await store.loadQuick(store.currentId);
  await nextTick();
  input.value?.focus();
});
function close() {
  store.quickOpen = false;
}
function pick(path: string | undefined) {
  if (!path) return;
  close();
  void store.openFile(store.currentId, path);
}
function key(e: KeyboardEvent) {
  if (e.key === "ArrowDown") {
    e.preventDefault();
    sel.value = Math.min(sel.value + 1, results.value.length - 1);
  } else if (e.key === "ArrowUp") {
    e.preventDefault();
    sel.value = Math.max(sel.value - 1, 0);
  } else if (e.key === "Enter") {
    e.preventDefault();
    pick(results.value[sel.value]);
  }
}
</script>

<template>
  <AppDialog :open="true" title="Find files" @close="close">
    <div class="qo" data-test="quick-open">
      <input
        ref="input"
        v-model="query"
        class="qo-input"
        placeholder="Type a file name"
        aria-label="File name"
        autocomplete="off"
        spellcheck="false"
        @keydown="key"
      />
      <ul class="qo-list" role="listbox">
        <li
          v-for="(p, i) in results"
          :key="p"
          role="option"
          :aria-selected="i === sel"
          :class="{ on: i === sel }"
          @click="pick(p)"
          @mousemove="sel = i"
        >
          <span class="qo-name">{{ p.split("/").pop() }}</span>
          <span class="qo-dir mono">{{ p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "" }}</span>
        </li>
        <li v-if="!results.length" class="qo-empty">No matching files.</li>
      </ul>
    </div>
  </AppDialog>
</template>

<style scoped>
.qo {
  display: grid;
  gap: var(--space-2);
}
.qo-input {
  height: var(--control-height);
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--ink);
  font: 14px var(--font-mono);
}
.qo-list {
  margin: 0;
  padding: 0;
  list-style: none;
  max-height: 340px;
  overflow-y: auto;
}
.qo-list li {
  display: flex;
  gap: var(--space-3);
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.qo-list li.on {
  background: var(--tint);
}
.qo-dir {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted);
  font-size: 12px;
}
.qo-empty {
  color: var(--muted);
}
</style>
